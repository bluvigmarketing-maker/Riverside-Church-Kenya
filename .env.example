# Copy this file to .env.local and fill in real values from your Supabase project
# (Project Settings -> API). Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — used by scripts/upload-media.ts and future admin work.
# Never expose this in client code or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
